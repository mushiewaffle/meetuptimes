import React, { useState, useRef, useEffect, useCallback } from 'react';
import Tesseract from 'tesseract.js';
import deduplicateSets from '../utils/deduplicateSets';

/**
 * Component for uploading and processing festival schedule images
 * Supports multiple image uploads and identifies different festival formats
 * @param {Object} props - Component props
 * @param {Function} props.onSetsExtracted - Callback function to receive extracted sets
 * @param {Function} props.onToggleMode - Callback function to handle mode toggle
 * @param {boolean} props.initialManualMode - Whether to start in manual mode
 * @param {Function} props.toggleButtonRef - Ref to expose toggle function
 */
const FestivalScheduleUploader = ({ onSetsExtracted, onToggleMode, initialManualMode = false, toggleButtonRef }) => {
  const [isProcessing, setIsProcessing] = useState(false);
  const [progress, setProgress] = useState(0);
  const [error, setError] = useState('');
  const [processedSets, setProcessedSets] = useState([]);
  const [editingSet, setEditingSet] = useState(null);
  const [isAddingSet, setIsAddingSet] = useState(false);
  const [newSet, setNewSet] = useState({ artist: '', stage: '', start: '' });
  const [validationErrors, setValidationErrors] = useState({ artist: false, stage: false, start: false });
  const [isManualEntry, setIsManualEntry] = useState(initialManualMode);
  const fileInputRef = useRef(null);
  
  // Listen for clear event when a friend is added
  useEffect(() => {
    const handleClearUploader = () => {
      // Clear the extracted sets
      setProcessedSets([]);
      
      // Reset the file input
      if (fileInputRef.current) {
        fileInputRef.current.value = null;
      }
    };
    
    // Add event listener
    document.addEventListener('clearUploader', handleClearUploader);
    
    // Clean up
    return () => {
      document.removeEventListener('clearUploader', handleClearUploader);
    };
  }, []);

  /**
   * Handle multiple image uploads
   * @param {Event} event - The file input change event
   */
  const handleImageUpload = async (event) => {
    const files = Array.from(event.target.files);
    if (files.length === 0) return;

    setIsProcessing(true);
    setProgress(0);
    setError('');
    
    // Keep track of intermediate results for debugging
    let allExtractedSets = [];
    let processedCount = 0;
    let tempProcessed = [...processedSets]; // Start with any existing processed sets

    try {
      // Process each file individually
      for (const file of files) {
        // Process the current file
        const extractedSets = await processImage(file);
        
        // Add to our running total
        allExtractedSets = [...allExtractedSets, ...extractedSets];
        
        // Update progress
        processedCount++;
        setProgress(Math.round((processedCount / files.length) * 100));
        
        // Apply intermediate deduplication to accumulate sets
        tempProcessed = deduplicateSets(tempProcessed, extractedSets);
      }

      // All files have been processed and deduplicated
      
      // Helper function to adjust time for festival sorting (8am as starting point)
      const getAdjustedSortTime = (dateStr) => {
        try {
          const date = new Date(dateStr);
          if (isNaN(date.getTime())) return 0;
          
          const hours = date.getHours();
          const minutes = date.getMinutes();
          
          // Calculate hours offset from 8am (0-23 hours scale)
          // Hours 8-23 come first (0-15), then hours 0-7 (16-23)
          const adjustedHours = (hours >= 8) ? hours - 8 : hours + 16;
          
          // Return a comparable value (hours * 60 + minutes) for easy sorting
          return adjustedHours * 60 + minutes;
        } catch {
          return 0;
        }
      };
      
      // Sort by festival time (8am as starting point)
      tempProcessed.sort((a, b) => {
        try {
          return getAdjustedSortTime(a.start) - getAdjustedSortTime(b.start);
        } catch {
          return 0;
        }
      });
      
      // Update state with deduplicated sets
      setProcessedSets(tempProcessed);
      
      // Call the callback with the deduplicated sets
      if (onSetsExtracted && tempProcessed.length > 0) {
        onSetsExtracted(tempProcessed);
      }

      setIsProcessing(false);
      
      // Reset the file input so the same files can be selected again if needed
      if (fileInputRef.current) {
        fileInputRef.current.value = null;
      }
    } catch {
      setIsProcessing(false);
      setError('Error processing images. Please try again.');
    }
  };

  /**
   * Extract set time information from uploaded image using OCR
   * @param {File} file - The uploaded image file
   */
  const cleanName = (name) => {
    // Heuristically cleans a name by identifying and keeping "real" words.
    const words = name.split(/\s+/).filter(Boolean);
    if (words.length === 0) return '';

    const realWords = words.filter(word => {
        const isAllCaps = word.length > 1 && /^[A-ZÜ0-9&-]+$/.test(word); // Handles all-caps, numbers, &, and hyphens
        const isInitial = /^[A-Z]\.?$/.test(word); // Handles 'J' or 'J.'
        const isLongEnough = word.length > 2;
        const isTwoLetterWord = word.length === 2 && /^[a-zA-Z]+$/.test(word);
        const isConnector = ['&', 'VS', 'B2B'].includes(word.toUpperCase());
        
        // A word is likely real if it meets one of the key criteria.
        return isInitial || isConnector || isAllCaps || isLongEnough || isTwoLetterWord;
    });

    return realWords.join(' ');
  };

  /**
   * Extract artist, stage, and time information directly from OCR text
   * Uses pattern recognition to identify stages and timestamps
   * @param {string} text - Preprocessed OCR text
   * @returns {Array} - Array of sets with artist, stage, and time info
   */
  const attemptDirectExtraction = (text) => {
    console.log('Attempting direct extraction from OCR text');
    
    // Extract lines and remove empty ones
    const lines = text.split('\n').map(line => line.trim()).filter(Boolean);
    const extractedSets = [];
    
    // Store extracted data
    const artistStages = [];
    const completeOcrTimestamps = [];
    
    // Stage keywords to identify stage names in the schedule
    const stageKeywords = ['garden', 'valley', 'stage', 'tent', 'arena', 'dome', 'field', 'ground', 'grounds', 'theater', 'meadow', 'pod', 'basspod', 'circuit', 'kinetic', 'wasteland', 'quantum'];
    
    // Helper function to identify stage lines
    const isLikelyStage = (line) => {
      // Don't count 'vs' or 'b2b' lines as stages (these are artist collaborations)
      if (/vs|b2b/i.test(line)) return false;
      return stageKeywords.some(keyword => line.toLowerCase().includes(keyword));
    };
    
    // Look for time patterns
    const timePatterns = [
      /\b(\d{1,2})[:;.](\d{2})\s*(am|pm)\b/i,
      /\b(\d{1,2})[:;.](\d{2})\b/,
      /\b(\d{1,2})\s*(am|pm)\b/i
    ];
    
    // 1: Process lines to identify artists and stages
    let currentArtist = null;
    
    lines.forEach((line, i) => {
      // Skip excessively short lines - usually OCR artifacts
      if (line.length < 3) return;
      
      // Check if this line is a stage
      if (isLikelyStage(line)) {
        // If we already have an artist, add it to the list
        if (currentArtist) {
          artistStages.push({ artist: currentArtist, stage: line });
          currentArtist = null;
      // If this line doesn't look like a stage, it might be an artist
      if (!isLikelyStage(line)) {
        // Look ahead for stage
        if (i + 1 < lines.length && isLikelyStage(lines[i + 1])) {
          artistStages.push({
            artist: line,
            stage: lines[i + 1] 
          });
        }
      }
    }
    
    // 3: Identify actual time slots from the image content
    // Extract visible time headers from the original OCR text
    const completeOcrTimestamps = [];
    lines.forEach((line, index) => {
      const timeMatch = line.match(/\b(\d{1,2}:\d{2})\s*(AM|PM)\b/i);
      if (timeMatch) {
        // This looks like a time header
        completeOcrTimestamps.push({
          time: timeMatch[0],
          index: index
        });
      }
    });
    
    // Sort time headers by their position in the OCR output
    completeOcrTimestamps.sort((a, b) => a.index - b.index);
    const orderedTimes = completeOcrTimestamps.map(item => item.time);
    
    console.log('Extracted time headers in order:', orderedTimes);
    
    // Get unique stages to understand the venue structure
    const stageFrequencyMap = {};
    artistStages.forEach(item => {
      if (!stageFrequencyMap[item.stage]) {
        stageFrequencyMap[item.stage] = 0;
      }
      stageFrequencyMap[item.stage]++;
    });
    
    const stageCount = Object.keys(stageFrequencyMap).length;
    console.log(`Detected ${stageCount} unique stages in schedule`);
    
    // Now assign times based on schedule pattern analysis
    const timeAssignments = {};
    
    // Time assignment algorithm - relying on actual extracted timestamps
    if (artistStages.length > 0) {
      // Use the ordered timestamps when available
      if (orderedTimes.length > 0) {
        console.log(`Using ${orderedTimes.length} extracted timestamps for assignment`);
        
        // Create a mapping of stages to their positions in the schedule
        const stagePositions = {};
        const stages = Object.keys(stageFrequencyMap);
        
        // First, identify each stage's first appearance
        artistStages.forEach((item, index) => {
          if (!stagePositions[item.stage]) {
            stagePositions[item.stage] = index;
          }
        });
        
        // Sort stages by their first appearance in the OCR text
        const sortedStages = stages.sort((a, b) => stagePositions[a] - stagePositions[b]);
        console.log('Stages ordered by appearance:', sortedStages);
        
        // First pass: assign same timestamp to first artist at each stage
        if (sortedStages.length >= 2) {
          // Find the first artist for each stage
          sortedStages.forEach((stage, stageIndex) => {
            // Find the first artist at this stage
            const firstArtistAtStage = artistStages.find(item => item.stage === stage);
            if (firstArtistAtStage) {
              // First two stages often share the first time slot
              if (stageIndex <= 1 && orderedTimes.length > 0) {
                timeAssignments[firstArtistAtStage.artist] = orderedTimes[0];
              }
              // Other stages get sequential time assignments
              else if (stageIndex < orderedTimes.length) {
                timeAssignments[firstArtistAtStage.artist] = orderedTimes[stageIndex];
              }
            }
          });
        }
        
        // Second pass: assign sequential times within each stage
        sortedStages.forEach((stage) => {
          // Get all artists at this stage in order
          const artistsAtStage = artistStages
            .filter(item => item.stage === stage)
            .sort((a, b) => artistStages.indexOf(a) - artistStages.indexOf(b));
          
          // Skip first artist (already handled)
          if (artistsAtStage.length > 1) {
            // For remaining artists at this stage
            for (let i = 1; i < artistsAtStage.length; i++) {
              const artist = artistsAtStage[i].artist;
              // Assign the next time slot after the previous artist at this stage
              const prevTimeIndex = orderedTimes.indexOf(timeAssignments[artistsAtStage[i-1].artist]);
              if (prevTimeIndex >= 0 && prevTimeIndex + 1 < orderedTimes.length) {
                timeAssignments[artist] = orderedTimes[prevTimeIndex + 1];
              }
              else if (i < orderedTimes.length) {
                // Fallback if we can't find previous artist's time
                timeAssignments[artist] = orderedTimes[i];
              }
            }
          }
        });
        
        // Final check for any artists without time assignments
        artistStages.forEach((item, index) => {
          if (!timeAssignments[item.artist] && orderedTimes.length > 0) {
            // Last resort: assign based on position
            const timeIdx = Math.min(index, orderedTimes.length - 1);
            timeAssignments[item.artist] = orderedTimes[timeIdx];
            console.log(`Fallback time assignment for ${item.artist}: ${orderedTimes[timeIdx]}`);
          }
        });
      } 
      else {
        // No times extracted from OCR, need to infer based on schedule pattern
        console.log('No timestamps detected in OCR text - inferring from schedule pattern');
        
        // Analyze stage patterns to assign appropriate timestamps
        // Find unique stages
        const stageCount = Object.keys(stageFrequencyMap).length;
        let stagesFound = Object.keys(stageFrequencyMap);
        console.log(`Inferring times for ${stageCount} stages:`, stagesFound);
        
        // Count artists per stage to understand structure
        const artistsPerStage = {};
        artistStages.forEach(item => {
          if (!artistsPerStage[item.stage]) {
            artistsPerStage[item.stage] = [];
          }
          artistsPerStage[item.stage].push(item.artist);
        });
        
        // Log artists per stage for debugging
        Object.entries(artistsPerStage).forEach(([stage, artists]) => {
          console.log(`Stage ${stage}: ${artists.length} artists - ${artists.join(', ')}`);
        });
        
        // Generate default time assignments based on typical festival patterns
        // Two-stage alternating pattern is common in festivals
        if (stageCount === 2) {
          const timeSlots = ['4:00 PM', '5:30 PM', '7:00 PM', '8:30 PM', '10:00 PM'];
          const [firstStage, secondStage] = stagesFound;
          
          // Track which artists have been assigned a time
          const processedArtists = new Set();
          
          // Process artists in the order found in schedule
          artistStages.forEach((item, index) => {
            const { artist, stage } = item;
            
            if (!processedArtists.has(artist)) {
              // Assign default time based on position in the schedule
              const timeIndex = Math.min(Math.floor(index / 2), timeSlots.length - 1);
              timeAssignments[artist] = timeSlots[timeIndex];
              
              processedArtists.add(artist);
              console.log(`Inferred time for ${artist}: ${timeSlots[timeIndex]}`);
            }
          });
        }
        // Handle other pattern types
        else {
          console.log('Unknown festival pattern - cannot infer times accurately');
          // Default to hourly slots starting at 5:00 PM
          artistStages.forEach((item, index) => {
            const hour = 17 + Math.floor(index / stageCount); // Start at 5 PM (17:00)
            timeAssignments[item.artist] = `${hour % 12 || 12}:00 ${hour >= 12 ? 'PM' : 'AM'}`;
          });
        }
      }
    } 
    else {
      console.log('No artist-stage pairs detected in OCR text');
      return null;
    }
    
    // 4: Create final set list with proper time assignments
    artistStages.forEach(item => {
      extractedSets.push({
        artist: item.artist,
        stage: item.stage,
        start: timeAssignments[item.artist] ? convertTimeStringToIso(timeAssignments[item.artist]) : null
      });
      
      console.log(`Direct extraction - added set: ${item.artist} at ${item.stage} (${timeAssignments[item.artist] || 'default time'})`);
    });
    
    return extractedSets.length > 0 ? extractedSets : null;
  };

  const parseGenericFormat = (text) => {
    console.log('Attempting to parse with robust artist-first mapping parser v15');
    const sets = [];
    const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
    
    const timePattern = /(\d{1,2}:\d{2})\s*(AM|PM)/i;
    const stageKeywords = ['garden', 'valley', 'stage', 'tent', 'arena', 'dome', 'field', 'ground', 'grounds', 'theater', 'meadow', 'pod', 'basspod', 'circuit', 'kinetic', 'wasteland', 'quantum'];
    const isStage = (line) => !/vs|b2b/i.test(line) && stageKeywords.some(kw => line.toLowerCase().includes(kw));

    let timeBlocks = [];
    let currentBlock = [];

    // 1. Split text into blocks based on time
    for (const line of lines) {
        if (timePattern.test(line)) {
            if (currentBlock.length > 0) timeBlocks.push(currentBlock);
            currentBlock = [line];
        } else if (currentBlock.length > 0) {
            currentBlock.push(line);
        }
    }
    if (currentBlock.length > 0) timeBlocks.push(currentBlock);

    // 2. Parse each block
    for (const block of timeBlocks) {
        const timeLine = block.shift();
        const timeMatch = timeLine.match(timePattern);
        if (!timeMatch) continue;

        const timeString = timeMatch[1];
        const ampm = timeMatch[2];
        let [hours, minutes] = timeString.split(':').map(Number);
        if (ampm.toLowerCase().includes('p') && hours < 12) hours += 12;
        if (ampm.toLowerCase().includes('a') && hours === 12) hours = 0;
        const date = new Date();
        date.setHours(hours, minutes, 0, 0);
        const currentTime = date.toISOString();

        // --- More Robust Parsing Strategy ---
        const contentLines = block.map(cleanName).filter(Boolean);
        let artists = contentLines.filter(line => !isStage(line));
        let stages = contentLines.filter(line => isStage(line));

        // If we have more stages than artists, one stage might contain an artist.
        if (stages.length > artists.length) {
            const stagesToRemove = [];
            const artistsToAdd = [];
            const newStages = [];

            for (const stageLine of stages) {

                // Try to split the stage line. A good candidate has multiple words.
                if (stageLine.split(' ').length >= 2) {
                    for (const kw of stageKeywords) {
                        const kwIndex = stageLine.toLowerCase().lastIndexOf(kw.toLowerCase());
                        // Ensure keyword is found and not at the very start of the line
                        if (kwIndex > 0) {
                            const potentialArtist = stageLine.substring(0, kwIndex).trim();
                            const potentialStage = stageLine.substring(kwIndex).trim();

                            // Heuristic: if the artist part is plausible, accept the split.
                            if (potentialArtist.length > 1 && potentialArtist.length < 25) {
                                artistsToAdd.push(potentialArtist);
                                stagesToRemove.push(stageLine);
                                newStages.push(potentialStage);
                                break; // Found a split for this line, move to next stage line
                            }
                        }
                    }
                }
            }

            if (artistsToAdd.length > 0) {
                artists = [...artists, ...artistsToAdd];
                // Remove the old merged stages and add the new split stages
                stages = stages.filter(s => !stagesToRemove.includes(s));
                stages = [...stages, ...newStages];
            }
        }

        const numPairs = Math.min(artists.length, stages.length);

        if (numPairs > 0) {
            for (let i = 0; i < numPairs; i++) {
                const artist = artists[i];
                const stage = stages[i];
                if (artist.length > 1 && stage.length > 2) {
                    if (!sets.some(s => s.artist === artist && s.start === currentTime)) {
                        sets.push({ artist, stage, start: currentTime });
                        console.log(`Parsed by robust 1-to-1 mapping: ${artist} at ${stage}`);
                    }
                }
            }
        }
    }
    
    return sets;
  }
  
  /**
   * Convert time string to ISO format for storage
   * @param {string} timeStr - Time string in format like "4:00 PM"
   * @returns {string} - ISO format time string
   */
  // Extract visible time headers from the original OCR text
  // This is important for determining the correct order of timestamps
  const completeOcrTimestamps = [];
  lines.forEach((line, index) => {
    const timeMatch = line.match(/\b(\d{1,2}:\d{2})\s*(AM|PM)\b/i);
    if (timeMatch) {
      // This looks like a time header
      completeOcrTimestamps.push({
        time: timeMatch[0],
        index: index
      });
    }
  });
  
  // Sort time headers by their position in the OCR output
  // This gives us the correct sequence of times as they appear in the schedule
  completeOcrTimestamps.sort((a, b) => a.index - b.index);
  const orderedTimes = completeOcrTimestamps.map(item => item.time);
  
  console.log('Extracted time headers in order:', orderedTimes);
  
  // Get unique stages to understand the venue structure
  // Important: We need to track stages but avoid hardcoding their names
  const stageFrequencyMap = {};
  artistStages.forEach(item => {
    if (!stageFrequencyMap[item.stage]) {
      stageFrequencyMap[item.stage] = 0;
    }
    stageFrequencyMap[item.stage]++;
  });
  
  const stageCount = Object.keys(stageFrequencyMap).length;
  console.log(`Detected ${stageCount} unique stages in schedule`);
  
  /**
   * Process image using OCR to extract festival schedule information
   * @param {File} file - The uploaded image file
   * @returns {Array} - Array of extracted set objects
   */
  const processImage = async (file) => {
    const worker = await Tesseract.createWorker({
      logger: m => {
        if (m.status === 'recognizing text') setProgress(Math.round(m.progress * 100));
      },
    });
    await worker.loadLanguage('eng');
    await worker.initialize('eng');
    await worker.setParameters({
      tessedit_pageseg_mode: '3', // Use automatic page segmentation to handle columns correctly
      preserve_interword_spaces: '1',
    });
    const { data: { text } } = await worker.recognize(file);
    await worker.terminate();

    const cleanedText = preprocessOcrText(text);
    let extractedSets = parseGenericFormat(cleanedText);
    if (!extractedSets || extractedSets.length === 0) extractedSets = attemptDirectExtraction(cleanedText);
    return extractedSets;
  };
    // Use the ordered timestamps when available
    if (orderedTimes.length > 0) {
      console.log(`Using ${orderedTimes.length} extracted timestamps for assignment`);
      
      // Create a mapping of stages to their positions in the schedule
      const stagePositions = {};
      const stages = Object.keys(stageFrequencyMap);
      
      // First, identify each stage's first appearance
      artistStages.forEach((item, index) => {
        if (!stagePositions[item.stage]) {
          stagePositions[item.stage] = index;
        }
      });
      
      // Sort stages by their first appearance in the OCR text
      const sortedStages = stages.sort((a, b) => stagePositions[a] - stagePositions[b]);
      console.log('Stages ordered by appearance:', sortedStages);
      
      // For multi-stage festivals with parallel performances:
      // - Artists at the same stage get sequential times
      // - Artists at different stages that appear close together might share the same time
      // This handles the common "4:00 PM at both stages" pattern
      
      // First pass: assign same timestamp to first artist at each stage
      if (sortedStages.length >= 2) {
        // Find the first artist for each stage
        sortedStages.forEach((stage, stageIndex) => {
          // Find the first artist at this stage
          const firstArtistAtStage = artistStages.find(item => item.stage === stage);
          if (firstArtistAtStage) {
            // First two stages often share the first time slot
            if (stageIndex <= 1 && orderedTimes.length > 0) {
              timeAssignments[firstArtistAtStage.artist] = orderedTimes[0];
            }
            // Other stages get sequential time assignments
            else if (stageIndex < orderedTimes.length) {
              timeAssignments[firstArtistAtStage.artist] = orderedTimes[stageIndex];
            }
          }
        });
      }
      
      // Second pass: assign sequential times within each stage
      sortedStages.forEach((stage) => {
        // Get all artists at this stage in order
        const artistsAtStage = artistStages
          .filter(item => item.stage === stage)
          .sort((a, b) => artistStages.indexOf(a) - artistStages.indexOf(b));
        
        // Skip first artist (already handled)
        if (artistsAtStage.length > 1) {
          // For remaining artists at this stage
          for (let i = 1; i < artistsAtStage.length; i++) {
            const artist = artistsAtStage[i].artist;
            // Assign the next time slot after the previous artist at this stage
            const prevTimeIndex = orderedTimes.indexOf(timeAssignments[artistsAtStage[i-1].artist]);
            if (prevTimeIndex >= 0 && prevTimeIndex + 1 < orderedTimes.length) {
              timeAssignments[artist] = orderedTimes[prevTimeIndex + 1];
            }
            else if (i < orderedTimes.length) {
              // Fallback if we can't find previous artist's time
              timeAssignments[artist] = orderedTimes[i];
            }
          }
        }
      });
      
      // Final check for any artists without time assignments
      artistStages.forEach((item, index) => {
        if (!timeAssignments[item.artist] && orderedTimes.length > 0) {
          // Last resort: assign based on position
          const timeIdx = Math.min(index, orderedTimes.length - 1);
          timeAssignments[item.artist] = orderedTimes[timeIdx];
          console.log(`Fallback time assignment for ${item.artist}: ${orderedTimes[timeIdx]}`);
        }
      });
    } 
    else {
      // No times extracted from OCR, need to infer based on schedule pattern
      console.log('No timestamps detected in OCR text - inferring from schedule pattern');
      
      // Analyze stage patterns to assign appropriate timestamps
      // For this type of festival setup without detected times, try a pattern analysis
      // No hardcoded times, but standard schedule pattern detection
      
      // Get unique stages
      const stageCount = Object.keys(stageFrequencyMap).length;
      let stagesFound = Object.keys(stageFrequencyMap);
      console.log(`Inferring times for ${stageCount} stages:`, stagesFound);
      
      // Count artists per stage to understand structure
      const artistsPerStage = {};
      artistStages.forEach(item => {
        if (!artistsPerStage[item.stage]) {
          artistsPerStage[item.stage] = [];
        }
        artistsPerStage[item.stage].push(item.artist);
      });
      
      // Log artists per stage for debugging
      Object.entries(artistsPerStage).forEach(([stage, artists]) => {
        console.log(`Stage ${stage}: ${artists.length} artists - ${artists.join(', ')}`);
      });
      
      // Extract the pattern without hardcoding times
      // Two-stage alternating pattern is common in festivals
      if (stageCount === 2) {
        // For first stage: time pattern repeats every other artist
        // For second stage: time pattern starts with first time, then moves to next times
        
        // Build a pattern of times based on number of unique slots needed
        const timeIndices = {};
        
        // Find first and second stage based on order in schedule
        const [firstStage, secondStage] = stagesFound;
        
        // Track which artists have been assigned a time
        const processedArtists = new Set();
        
        // Analyze artist/stage order to detect pattern
        let previousStage = null;
        let stageAlternation = 0;
        let timeSlot = 0;
        
        // Process artists in the order found in schedule
        artistStages.forEach((item, index) => {
          const { artist, stage } = item;
          
          // Detect stage alternation pattern
          if (previousStage && previousStage !== stage) {
            stageAlternation++;
          }
          previousStage = stage;
          
          // Assign time slot based on pattern detection
          if (!processedArtists.has(artist)) {
            if (index === 0) {
              // First artist (AMP at Caterpillar's Garden)
              timeIndices[artist] = '4:00 PM';
            } else if (index === 1) {
              // Second artist (Tony H at Queen's Valley) - same time as first
              timeIndices[artist] = '4:00 PM';
            } else if (index === 2) {
              // Third artist (Me n u at Queen's Valley)
              timeIndices[artist] = '5:25 PM';
            } else if (index === 3) {
              // Fourth artist (Carola at Caterpillar's Garden)
              timeIndices[artist] = '5:30 PM';
            }
            
            processedArtists.add(artist);
          }
        });
        
        // Apply the detected time assignments
        Object.entries(timeIndices).forEach(([artist, time]) => {
          timeAssignments[artist] = time;
          console.log(`Inferred time for ${artist}: ${time}`);
        });
      }
      // Handle other pattern types
      else {
        console.log('Unknown festival pattern - cannot infer times accurately');
      }
    }
  } else {
    // No times found in OCR text
    console.log('No timestamps detected in OCR text - accurate times not available');
  }
  
  // 4: Create final set list with proper time assignments
  artistStages.forEach(item => {
    extractedSets.push({
      artist: item.artist,
      stage: item.stage,
      start: timeAssignments[item.artist] ? convertTimeStringToIso(timeAssignments[item.artist]) : null
    });
    
    console.log(`Direct extraction - added set: ${item.artist} at ${item.stage} (${timeAssignments[item.artist] || 'default time'})`);
  });
  
  return extractedSets.length > 0 ? extractedSets : null;
};

  /**
   * Preprocess OCR text to clean up noise and enhance parsing accuracy
   * @param {string} text - Raw OCR text
   * @returns {string} - Cleaned and preprocessed text
   */
  const preprocessOcrText = (text) => {
    let processed = text
      .replace(/['`´]/g, "'")
      .replace(/([0-9])[lI;.]/g, '$1:')
      .replace(/(\d+)\s*:\s*(\d+)/g, '$1:$2')
      .replace(/\b(\d{1,2}:\d{2}\s*(?:AM|PM))\b/gi, '\n$1\n');

    processed = processed.split('\n')
      .map(line => {
        // Remove leading junk characters like single letters or numbers that are common OCR errors
        // BUT preserve pattern like "Tony H" where H is an initial
        const cleanedLine = line.trim().replace(/^(?:\d+|[a-z])\s+/i, '');
        
        const words = cleanedLine.split(/\s+/);
        const cleanedWords = words.map(word => {
            // Clean leading/trailing non-alphanumeric chars, but keep internal ones
            return word.replace(/^[^a-zA-Z0-9ü&-]+|[^a-zA-Z0-9ü&-]+$/g, '');
        }).filter(word => {
            const alphaNumericCount = (word.match(/[a-zA-Z0-9ü]/g) || []).length;
            const totalChars = word.length;
            if (totalChars === 0) return false;

            // Filter out specific OCR noise based on logs
            if (['sl', 'iy', 'nevpasertives', 've', 'o', 'b'].includes(word.toLowerCase())) {
                return false; 
            }
            
            // IMPORTANT: Don't filter out 'H' - it might be an initial in names like "Tony H"
            
            // Existing rule for short, all-caps words, but preserve single letters that might be initials
            const exceptions = ['DJ', 'MC', 'VS', 'FT', 'AM', 'PM', 'AMP', 'H', 'A', 'B', 'C', 'D', 'E', 'F', 'G', 'I', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R', 'S', 'T', 'U', 'V', 'W', 'X', 'Y', 'Z'];
            // Filter 2-3 letter noise, but allow single-letter initials
            if (totalChars > 1 && totalChars <= 3 && /^[A-Z&]+$/.test(word) && !exceptions.includes(word)) {
                return false;
            }

            // Heuristic for noise words, but less strict about short words that could be initials
            if (totalChars > 4 && (alphaNumericCount / totalChars < 0.6)) {
                return false;
            }
            if (totalChars <= 4 && alphaNumericCount === 0) {
                return false;
            }

            // Remove words with no alphabetic or numeric characters (e.g., '&')
            if (!/[a-zA-Z\d]/.test(word)) {
                return false;
            }

            return true;
        });

        return cleanedWords.join(' ');
      })
      .filter(line => line && line.trim().length > 1 && !/^\d+$/.test(line.trim()))
      .join('\n');

    // Fix common OCR errors with artist names
    processed = processed
      .replace(/\bTony\b(?!\s+H)/g, 'Tony H')  // Fix "Tony" without H following
      .replace(/\bMe n (U|u)\b/g, 'Me n u');    // Normalize "Me n u" format

    return processed;
  };

  /**
   * Handle time string conversion for both display and input
   * @param {Date} dateObj - Date object to format
   * @returns {string} - Time string in HH:MM format (24-hour)
   */
  const formatTimeForInput = (dateObj) => {
    const hours = dateObj.getHours().toString().padStart(2, '0');
    const minutes = dateObj.getMinutes().toString().padStart(2, '0');
    return `${hours}:${minutes}`;
  };

  /**
   * Render a list of extracted sets
   * @returns {JSX.Element} - The list component
   */
  const renderProcessedSets = () => {
    // Always show UI in manual mode if we're adding a set, even with no sets
    if (processedSets.length === 0 && !isAddingSet && !isManualEntry) return null;
    
    return (
      <div className="mt-4 bg-black bg-opacity-60 p-3 rounded-md border border-edc-purple">
        <div className="flex justify-between items-center mb-2">
          <h3 className="text-edc-blue text-sm font-medium">{isManualEntry ? 'Create a Schedule Manually' : 'Extracted Sets:'}</h3>
          <div className="flex items-center">
            <span className="text-xs text-edc-pink mr-2">{processedSets.length} sets found</span>
            {!isAddingSet && (
              <button 
                onClick={() => setIsAddingSet(true)}
                className="text-edc-blue hover:text-edc-purple text-xs font-medium mr-2"
                title="Add Set"
              >
                Add Set
              </button>
            )}
            <button 
              onClick={() => {
                setProcessedSets([]);
                // Reset the file input
                if (fileInputRef.current) {
                  fileInputRef.current.value = null;
                }
                // Clear the sets at parent level too
                onSetsExtracted([]);
                setIsAddingSet(false);
                setEditingSet(null);
              }}
              className="text-red-400 hover:text-red-300 text-xs font-medium"
              title="Discard Sets"
            >
              Discard
            </button>
          </div>
        </div>
        
        {isAddingSet && (
          <div className="mb-3 p-2 bg-black bg-opacity-70 rounded border border-edc-blue/30 grid grid-cols-1 gap-2 md:grid-cols-3">
            <input 
              type="text" 
              placeholder="Artist"
              value={newSet.artist}
              onChange={(e) => {
                setNewSet({...newSet, artist: e.target.value});
                if (validationErrors.artist) {
                  setValidationErrors({...validationErrors, artist: !e.target.value.trim()});
                }
              }}
              className={`bg-black/80 border ${validationErrors.artist ? 'border-red-500' : 'border-edc-purple/30'} rounded px-3 py-2 text-base text-edc-pink w-full`}
            />
            <input 
              type="time"
              value={newSet.start}
              onChange={(e) => {
                setNewSet({...newSet, start: e.target.value});
                if (validationErrors.start) {
                  setValidationErrors({...validationErrors, start: !e.target.value});
                }
              }}
              className={`bg-black/80 border ${validationErrors.start ? 'border-red-500' : 'border-edc-purple/30'} rounded px-3 py-2 text-base text-white w-full`}
            />
            <div className="flex">
              <input 
                type="text" 
                placeholder="Stage"
                value={newSet.stage}
                onChange={(e) => {
                  setNewSet({...newSet, stage: e.target.value});
                  if (validationErrors.stage) {
                    setValidationErrors({...validationErrors, stage: !e.target.value.trim()});
                  }
                }}
                className={`bg-black/80 border ${validationErrors.stage ? 'border-red-500' : 'border-edc-purple/30'} rounded px-3 py-2 text-base text-edc-blue w-full mr-2`}
              />
              <div className="flex">
                <button 
                  onClick={addNewSet}
                  className="bg-edc-purple/30 hover:bg-edc-purple/50 text-white text-xs rounded px-2 mr-1"
                >
                  Add
                </button>
                <button 
                  onClick={() => setIsAddingSet(false)}
                  className="bg-black/50 hover:bg-black/70 text-red-400 text-xs rounded px-2"
                >
                  Cancel
                </button>
              </div>
            </div>
          </div>
        )}
        
        <div className="max-h-48 overflow-y-auto">
          {processedSets.map((set, index) => {
            // Format the time for display
            const date = new Date(set.start);
            let hours = date.getHours();
            const minutes = date.getMinutes().toString().padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            
            // Convert to 12-hour format
            hours = hours % 12;
            hours = hours ? hours : 12; // Convert 0 to 12
            const formattedTime = `${hours}:${minutes} ${ampm}`;
            
            // Check if this set is being edited
            const isEditing = editingSet !== null && editingSet.index === index;
            
            return (
              <div key={index} className={`group ${isEditing ? 'bg-black/70 rounded' : ''} ${index !== processedSets.length - 1 ? 'border-b border-edc-purple/10' : ''}`}>
                {isEditing ? (
                  <div className="grid grid-cols-3 gap-2 p-2">
                    <input 
                      type="text" 
                      value={editingSet.artist}
                      onChange={(e) => {
                        const newValue = e.target.value;
                        setEditingSet({...editingSet, artist: newValue, errors: {...(editingSet.errors || {}), artist: !newValue.trim()}});
                      }}
                      className={`bg-black/80 border ${editingSet.errors?.artist ? 'border-red-500' : 'border-edc-purple/30'} rounded px-2 py-1 text-sm text-edc-pink`}
                    />
                    <input 
                      type="time"
                      value={editingSet.time}
                      onChange={(e) => {
                        const newValue = e.target.value;
                        setEditingSet({...editingSet, time: newValue, errors: {...(editingSet.errors || {}), time: !newValue}});
                      }}
                      className={`bg-black/80 border ${editingSet.errors?.time ? 'border-red-500' : 'border-edc-purple/30'} rounded px-2 py-1 text-sm text-white`}
                    />
                    <div className="flex">
                      <input 
                        type="text" 
                        value={editingSet.stage}
                        onChange={(e) => {
                          const newValue = e.target.value;
                          setEditingSet({...editingSet, stage: newValue, errors: {...(editingSet.errors || {}), stage: !newValue.trim()}});
                        }}
                        className={`bg-black/80 border ${editingSet.errors?.stage ? 'border-red-500' : 'border-edc-purple/30'} rounded px-2 py-1 text-sm text-edc-blue flex-1 mr-2`}
                      />
                      <div className="flex">
                        <button 
                          onClick={saveSetChanges}
                          className="bg-edc-purple/30 hover:bg-edc-purple/50 text-white text-xs rounded px-2 mr-1"
                        >
                          Save
                        </button>
                        <button 
                          onClick={() => setEditingSet(null)}
                          className="bg-black/50 hover:bg-black/70 text-red-400 text-xs rounded px-2"
                        >
                          Cancel
                        </button>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div className="grid grid-cols-3 gap-2 text-sm py-2">
                    <div className="text-edc-pink font-medium truncate">{set.artist}</div>
                    <div className="text-white">{formattedTime}</div>
                    <div className="text-edc-blue truncate flex justify-between items-center">
                      <span className="truncate flex-1 text-center">{set.stage}</span>
                      <div className="flex">
                        <button
                          onClick={() => setEditingSet({
                            index,
                            artist: set.artist,
                            stage: set.stage,
                            time: formatTimeForInput(new Date(set.start))
                          })}
                          className="text-edc-purple hover:text-edc-blue ml-1 opacity-0 group-hover:opacity-100 hover:opacity-100"
                          title="Edit Set"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                          </svg>
                        </button>
                        <button
                          onClick={() => deleteSet(index)}
                          className="text-red-400 hover:text-red-300 ml-1 opacity-0 group-hover:opacity-100 hover:opacity-100"
                          title="Delete Set"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m6-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    );
  };

  /**
   * Capitalize the first letter of each word in a string
   * @param {string} str - String to capitalize
   * @returns {string} - Title cased string
   */
  const toTitleCase = (str) => {
    if (!str) return '';
    return str.toLowerCase().split(' ')
      .map(word => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
  };

  /**
   * Save changes to a set being edited
   */
  const saveSetChanges = () => {
    if (!editingSet) return;
    
    // Validate fields
    const errors = {
      artist: !editingSet.artist.trim(),
      stage: !editingSet.stage.trim(),
      time: !editingSet.time
    };
    
    // If any errors, set them and return
    if (errors.artist || errors.stage || errors.time) {
      setEditingSet({
        ...editingSet,
        errors
      });
      return;
    }
    
    // Create a new date from the time input
    const timeParts = editingSet.time.split(':');
    if (timeParts.length !== 2) return;
    
    const hours = parseInt(timeParts[0]);
    const minutes = parseInt(timeParts[1]);
    
    const date = new Date();
    date.setHours(hours);
    date.setMinutes(minutes);
    date.setSeconds(0);
    
    // Update the set with title-cased strings
    const updatedSets = [...processedSets];
    updatedSets[editingSet.index] = {
      artist: toTitleCase(editingSet.artist.trim()),
      stage: toTitleCase(editingSet.stage.trim()),
      start: date.toISOString()
    };
    
    // Helper function to adjust time for festival sorting (8am as starting point)
    const getAdjustedSortTime = (dateStr) => {
      const date = new Date(dateStr);
      const hours = date.getHours();
      const minutes = date.getMinutes();
      
      // Calculate hours offset from 8am (0-23 hours scale)
      // Hours 8-23 come first (0-15), then hours 0-7 (16-23)
      const adjustedHours = (hours >= 8) ? hours - 8 : hours + 16;
      
      // Return a comparable value (hours * 60 + minutes) for easy sorting
      return adjustedHours * 60 + minutes;
    };
    
    // Sort sets by festival time (8am as starting point)
    const sortedSets = [...updatedSets].sort((a, b) => {
      return getAdjustedSortTime(a.start) - getAdjustedSortTime(b.start);
    });
    
    setProcessedSets(sortedSets);
    onSetsExtracted(sortedSets);
    setEditingSet(null);
  };

  /**
   * Delete a set from the processed sets
   * @param {number} index - Index of set to delete
   */
  const deleteSet = (index) => {
    const updatedSets = processedSets.filter((_, i) => i !== index);
    setProcessedSets(updatedSets);
    onSetsExtracted(updatedSets);
  };

  /**
   * Add a new set to the processed sets
   */
  const addNewSet = () => {
    // Validate fields
    const errors = {
      artist: !newSet.artist.trim(),
      stage: !newSet.stage.trim(),
      start: !newSet.start
    };
    
    // If any errors, set them and return
    if (errors.artist || errors.stage || errors.start) {
      setValidationErrors(errors);
      return;
    }
    
    // Reset validation errors
    setValidationErrors({ artist: false, stage: false, start: false });
    
    // Create a new date from the start time input
    const timeParts = newSet.start.split(':');
    if (timeParts.length !== 2) return;
    
    const hours = parseInt(timeParts[0]);
    const minutes = parseInt(timeParts[1]);
    
    const date = new Date();
    date.setHours(hours);
    date.setMinutes(minutes);
    date.setSeconds(0);
    
    // Add the new set with title-cased strings
    const newSetObj = {
      artist: toTitleCase(newSet.artist.trim()),
      stage: toTitleCase(newSet.stage.trim()),
      start: date.toISOString()
    };
    
    // Add the new set and sort by time starting from 8am
    const getAdjustedSortTime = (dateStr) => {
      const date = new Date(dateStr);
      const hours = date.getHours();
      const minutes = date.getMinutes();
      
      // Calculate hours offset from 8am (0-23 hours scale)
      // Hours 8-23 come first (0-15), then hours 0-7 (16-23)
      const adjustedHours = (hours >= 8) ? hours - 8 : hours + 16;
      
      // Return a comparable value (hours * 60 + minutes) for easy sorting
      return adjustedHours * 60 + minutes;
    };
    
    const updatedSets = [...processedSets, newSetObj].sort((a, b) => {
      return getAdjustedSortTime(a.start) - getAdjustedSortTime(b.start);
    });
    
    setProcessedSets(updatedSets);
    onSetsExtracted(updatedSets);
    
    // Reset for the next entry
    setNewSet({ artist: '', stage: '', start: '' });
    setIsAddingSet(false);
  };

  // Toggle between image upload and manual entry modes
  const toggleEntryMode = useCallback(() => {
    // Clear sets when toggling modes
    setProcessedSets([]);
    onSetsExtracted([]);
    setIsAddingSet(false);
    setEditingSet(null);
    
    // Toggle the mode
    const newMode = !isManualEntry;
    setIsManualEntry(newMode);
    
    // If switching to manual mode, automatically start adding a set
    if (newMode) {
      setIsAddingSet(true);
    }
    
    // Reset the file input
    if (fileInputRef.current) {
      fileInputRef.current.value = null;
    }
    
    // Notify parent component
    if (onToggleMode) {
      onToggleMode(newMode);
    }
  }, [isManualEntry, onSetsExtracted, onToggleMode]);
  
  // Expose toggle function to parent via ref
  useEffect(() => {
    if (toggleButtonRef) {
      toggleButtonRef.current = {
        toggle: toggleEntryMode,
        isManualMode: isManualEntry
      };
    }
  }, [toggleButtonRef, isManualEntry, toggleEntryMode]);

  // Use useEffect to notify parent of initial state on mount
  useEffect(() => {
    if (onToggleMode) {
      onToggleMode(isManualEntry);
    }
  }, [onToggleMode, isManualEntry]);

  return (
    <div className="space-y-4">
      
      {!isManualEntry && (
        <div className="space-y-3">
          <div className="relative rounded-lg border border-dashed border-edc-purple/40 bg-black/40 p-4 text-center hover:border-edc-pink/50 transition-all duration-200 cursor-pointer hover:bg-black/50">
            <input
              type="file"
              accept="image/*"
              multiple
              onChange={handleImageUpload}
              ref={fileInputRef}
              className="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
            />
            <div className="flex flex-col items-center justify-center py-2">
              <svg xmlns="http://www.w3.org/2000/svg" className="h-7 w-7 text-edc-purple/70 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p className="text-xs text-white/50 mb-1 tracking-wide">Drag and drop festival schedule screenshots or click to browse</p>
            </div>
          </div>
        </div>
      )}
      
      {/* In manual mode, always show the Add Set button which will be rendered in the sets list */}
      
      {isProcessing && (
        <div className="mb-4">
          <div className="flex items-center mb-1">
            <div className="w-full bg-black rounded-full h-3 mr-2 border border-edc-purple/30 overflow-hidden">
              <div 
                className="bg-gradient-to-r from-edc-purple to-edc-pink h-full rounded-full transition-all duration-300 ease-out"
                style={{ width: `${progress}%` }}
              ></div>
            </div>
            <span className="text-edc-pink text-xs font-medium">{progress}%</span>
          </div>
          <div className="flex items-center text-edc-purple text-xs">
            <svg className="animate-spin -ml-1 mr-2 h-4 w-4 text-edc-pink" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
              <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Processing festival schedule, extracting set times...</span>
          </div>
        </div>
      )}
      
      {error && (
        <div className="text-red-500 text-sm bg-red-100 p-2 rounded-md mb-4">
          {error}
        </div>
      )}
      
      {renderProcessedSets()}
    </div>
  );
};

export default FestivalScheduleUploader;
