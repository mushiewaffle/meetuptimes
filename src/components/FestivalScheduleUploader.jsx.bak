import React, { useState, useEffect, useRef, useCallback } from 'react';

/**
 * Component for parsing festival schedule data
 * Supports AI-generated table input and manual entry
 * @param {Object} props - Component props
 * @param {Function} props.onSetsExtracted - Callback function to receive extracted sets
 * @param {Function} props.onToggleMode - Callback function to handle mode toggle
 * @param {boolean} props.initialManualMode - Whether to start in manual mode
 * @param {Function} props.toggleButtonRef - Ref to expose toggle function
 */
const FestivalScheduleUploader = ({ onSetsExtracted, onToggleMode, initialManualMode = true, toggleButtonRef }) => {

  const [tableInput, setTableInput] = useState('');
  const [isProcessing, setIsProcessing] = useState(false);
  const [errorMessage, setErrorMessage] = useState('');
  const [processedSets, setProcessedSets] = useState([]);
  const [isAddingSet, setIsAddingSet] = useState(false);
  const [tempNewSet, setTempNewSet] = useState(null);
  const [editingSet, setEditingSet] = useState(null);
  
  // Refs for detecting clicks outside of forms
  const editFormRef = useRef(null);
  const addFormRef = useRef(null); // For storing new set info
  const [isManualEntry, setIsManualEntry] = useState(initialManualMode);

  // Listen for clear event when a friend is added
  useEffect(() => {
    const handleClearUploader = () => {
      // Clear the extracted sets
      setProcessedSets([]);
    };
    
    // Add event listener
    document.addEventListener('clearUploader', handleClearUploader);
    
    // Clean up
    return () => {
      document.removeEventListener('clearUploader', handleClearUploader);
    };
  }, []);

  // Handle click-away to cancel edit
  useEffect(() => {
    function handleClickOutside(event) {
      // Ignore clicks on show more/hide sets buttons to prevent interference
      if (event.target.closest('[data-action="toggle-schedule-expanded"]')) {
        return;
      }
      
      // Check if the click was outside the edit form
      if (editingSet && editFormRef.current && !editFormRef.current.contains(event.target)) {
        setEditingSet(null);
      }
      
      // Also handle click-away for adding new set
      if (isAddingSet && addFormRef.current && !addFormRef.current.contains(event.target)) {
        // Only cancel if the click wasn't on any "add set" button
        // Check if clicked element or any of its parents has data-add-set-button attribute
        const clickedOnAddButton = event.target.closest('[data-add-set-button]');
        
        if (!clickedOnAddButton) {
          setIsAddingSet(false);
          setTempNewSet(null);
        }
      }
    }
    
    // Add event listener
    document.addEventListener('mousedown', handleClickOutside);
    return () => {
      // Remove event listener on cleanup
      document.removeEventListener('mousedown', handleClickOutside);
    };
  }, [editingSet, isAddingSet]);

  // Parse table input from AI GPT
  const parseTableInput = (input) => {
    if (!input.trim()) return [];
    
    const lines = input.trim().split('\n');
    const parsedSets = [];
    let headerRow = null;
    let columnIndices = { artist: 0, time: 1, stage: 2 }; // Default order: artist, time, stage
    
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      
      // Skip empty lines and separator lines with dashes
      if (!line.trim() || line.includes('---')) {
        continue;
      }
      
      // Extract column data from the table row
      const columns = line.split('|').map(col => col.trim()).filter(col => col);
      
      // If this is the first non-empty, non-separator line, treat it as a header
      if (!headerRow && columns.length >= 3) {
        headerRow = columns;
        
        // Determine column positions based on header
        for (let j = 0; j < headerRow.length; j++) {
          const header = headerRow[j].toLowerCase();
          if (header.includes('artist') || header.includes('dj') || header.includes('performer')) {
            columnIndices.artist = j;
          } else if (header.includes('time') || header.includes('start')) {
            columnIndices.time = j;
          } else if (header.includes('stage') || header.includes('location')) {
            columnIndices.stage = j;
          }
        }
        continue;
      }
      
      // Process data rows
      if (columns.length >= 3) {
        const artist = columns[columnIndices.artist];
        const timeStr = columns[columnIndices.time];
        const stage = columns[columnIndices.stage];
        
        const time = convertToTimeFormat(timeStr);
        
        if (time && artist && stage) {
          parsedSets.push({
            time,
            artist,
            stage
          });
        }
      }
    }
    
    return parsedSets;
  };

  // Process table input and directly create schedule in AI parser mode
  const processTableInput = () => {
    if (!tableInput.trim()) return;
    
    // Clear any previous error messages
    setErrorMessage('');
    setIsProcessing(true);
    try {
      const parsedSets = parseTableInput(tableInput);
      
      if (parsedSets.length === 0) {
        setErrorMessage('No valid sets found in the table. Please check the format and make sure it includes Artist, Time, and Stage columns.');
        setIsProcessing(false);
        return;
      }
      
      // Convert to the format expected by the parent component (with ISO date strings)
      const formattedSets = parsedSets.map(set => {
        const [hours, minutes] = set.time.split(':').map(Number);
        const today = new Date();
        const date = new Date(today.getFullYear(), today.getMonth(), today.getDate(), hours, minutes);
        
        return {
          artist: set.artist,
          stage: set.stage,
          start: date.toISOString()
        };
      });
      
      // In AI Parser mode, directly create a schedule instead of just showing extracted sets
      if (!isManualEntry && formattedSets.length > 0) {
        // Directly dispatch an event to add the schedule
        const event = new CustomEvent('addScheduleFromAI', { 
          detail: { sets: formattedSets } 
        });
        document.dispatchEvent(event);
        
        // Clear input after successful processing
        setTableInput('');
        setProcessedSets([]); // Clear any processed sets
      } else {
        // Manual mode or fallback: just update the processed sets
        setProcessedSets(formattedSets);
        if (onSetsExtracted && formattedSets.length > 0) {
          onSetsExtracted(formattedSets);
        }
      }
    } catch (error) {
      console.error('Error processing table input:', error);
      setErrorMessage('Error parsing the table. Please check the format and make sure it follows the example shown in the placeholder.');
    } finally {
      setIsProcessing(false);
    }
  };

  // Helper function to convert time string to 24-hour format for time input
  const convertToTimeFormat = (timeStr) => {
    if (!timeStr) return '';
    
    try {
      // Handle formats like "4:00 PM", "5:25 PM", etc.
      const match = timeStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)?/i);
      if (match) {
        let [, hours, minutes, period] = match;
        hours = parseInt(hours);
        minutes = parseInt(minutes);
        
        if (period) {
          period = period.toUpperCase();
          if (period === 'PM' && hours !== 12) {
            hours += 12;
          } else if (period === 'AM' && hours === 12) {
            hours = 0;
          }
        }
        
        return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
      }
      
      return '';
    } catch {
      return '';
    }
  };

  /**
   * Handle time string conversion for both display and input
   * @param {Date} dateObj - Date object to format
   * @returns {string} - Time string in HH:MM format (24-hour)
   */
  const formatTimeForInput = (dateObj) => {
    const hours = dateObj.getHours().toString().padStart(2, '0');
    const minutes = dateObj.getMinutes().toString().padStart(2, '0');
    return `${hours}:${minutes}`;
  };

  /**
   * Capitalize the first letter of each word in a string
   * @param {string} str - String to capitalize
   * @returns {string} - Title cased string
   */
  const toTitleCase = (str) => {
    if (!str) return '';
    return str.toLowerCase().split(' ')
      .map(word => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
  };

  /**
   * Save changes to a set being edited
   */
  const saveSetChanges = () => {
    if (!editingSet) return;
    
    // Validate fields
    const errors = {
      artist: !editingSet.artist.trim(),
      stage: !editingSet.stage.trim(),
      time: !editingSet.time
    };
    
    // If any errors, set them and return
    if (errors.artist || errors.stage || errors.time) {
      setEditingSet({
        ...editingSet,
        errors
      });
      return;
    }
    
    // Create a new date from the time input
    const timeParts = editingSet.time.split(':');
    if (timeParts.length !== 2) return;
    
    const hours = parseInt(timeParts[0]);
    const minutes = parseInt(timeParts[1]);
    
    const date = new Date();
    date.setHours(hours);
    date.setMinutes(minutes);
    date.setSeconds(0);
    
    // Update the set with title-cased strings
    const updatedSets = [...processedSets];
    updatedSets[editingSet.index] = {
      artist: toTitleCase(editingSet.artist.trim()),
      stage: toTitleCase(editingSet.stage.trim()),
      start: date.toISOString()
    };
    
    // Helper function to adjust time for festival sorting (8am as starting point)
    const getAdjustedSortTime = (dateStr) => {
      const date = new Date(dateStr);
      const hours = date.getHours();
      const minutes = date.getMinutes();
      
      // Calculate hours offset from 8am (0-23 hours scale)
      // Hours 8-23 come first (0-15), then hours 0-7 (16-23)
      const adjustedHours = (hours >= 8) ? hours - 8 : hours + 16;
      
      // Return a comparable value (hours * 60 + minutes) for easy sorting
      return adjustedHours * 60 + minutes;
    };
    
    // Sort sets by festival time (8am as starting point)
    const sortedSets = [...updatedSets].sort((a, b) => {
      return getAdjustedSortTime(a.start) - getAdjustedSortTime(b.start);
    });
    
    setProcessedSets(sortedSets);
    onSetsExtracted(sortedSets);
    setEditingSet(null);
  };

  /**
   * Delete a set from the processed sets
   * @param {number} index - Index of set to delete
   */
  const deleteSet = (index) => {
    const updatedSets = processedSets.filter((_, i) => i !== index);
    setProcessedSets(updatedSets);
    onSetsExtracted(updatedSets);
  };

  /**
   * Add a new set to the processed sets
   */
  const addNewSet = () => {
    if (!tempNewSet) return;
    
    // Validate fields
    const errors = {
      artist: !tempNewSet.artist?.trim(),
      stage: !tempNewSet.stage?.trim(),
      time: !tempNewSet.time
    };
    
    // If any errors, set them and return
    if (errors.artist || errors.stage || errors.time) {
      setTempNewSet({
        ...tempNewSet,
        errors
      });
      return;
    }
    
    // Create a new date from the time input
    const timeParts = tempNewSet.time.split(':');
    if (timeParts.length !== 2) return;
    
    const hours = parseInt(timeParts[0]);
    const minutes = parseInt(timeParts[1]);
    
    const date = new Date();
    date.setHours(hours);
    date.setMinutes(minutes);
    date.setSeconds(0);
    
    // Add the new set with title-cased strings
    const newSetObj = {
      artist: toTitleCase(tempNewSet.artist.trim()),
      stage: toTitleCase(tempNewSet.stage.trim()),
      start: date.toISOString()
    };
    
    // Add the new set and sort by time starting from 8am
    const getAdjustedSortTime = (dateStr) => {
      const date = new Date(dateStr);
      const hours = date.getHours();
      const minutes = date.getMinutes();
      
      // Calculate hours offset from 8am (0-23 hours scale)
      // Hours 8-23 come first (0-15), then hours 0-7 (16-23)
      const adjustedHours = (hours >= 8) ? hours - 8 : hours + 16;
      
      // Return a comparable value (hours * 60 + minutes) for easy sorting
      return adjustedHours * 60 + minutes;
    };
    
    const updatedSets = [...processedSets, newSetObj].sort((a, b) => {
      return getAdjustedSortTime(a.start) - getAdjustedSortTime(b.start);
    });
    
    setProcessedSets(updatedSets);
    onSetsExtracted(updatedSets);
    
    // Reset for the next entry
    setTempNewSet(null);
    setIsAddingSet(false);
  };

  /**
   * Render a list of extracted sets
   * @returns {JSX.Element} - The list component
   */
  const renderProcessedSets = () => {
    // Always show UI in manual mode if we're adding a set, even with no sets
    if (processedSets.length === 0 && !isAddingSet && !isManualEntry) return null;
    
    return (
      <div className="mt-6">
        <h3 className="text-white text-sm font-medium mb-3">Extracted Sets ({processedSets.length})</h3>
        
        <div className="space-y-1 max-h-[300px] overflow-y-auto pr-1 custom-scrollbar">
          {processedSets.map((set, index) => {
            const formattedTime = formatTime(set.start);
            const isEditing = editingSet && editingSet.index === index;
            
            return (
              <div key={index} className={`group ${index !== processedSets.length - 1 ? 'border-b border-edc-purple/10' : ''}`}>
                {isEditing ? (
                  <form 
                    ref={editFormRef}
                    onSubmit={(e) => {
                      e.preventDefault();
                      saveSetChanges();
                    }} 
                    className="grid grid-cols-[1fr_auto_1fr] md:grid-cols-3 gap-2 text-sm py-2 group"
                  >
                    <input 
                      type="text" 
                      placeholder="Artist"
                      value={editingSet.artist}
                      onChange={(e) => {
                        const newValue = e.target.value;
                        setEditingSet({...editingSet, artist: newValue, errors: {...(editingSet.errors || {}), artist: !newValue.trim()}});
                      }}
                      onKeyDown={(e) => {
                        if (e.key === 'Escape') {
                          setEditingSet(null);
                        } else if (e.key === 'Enter') {
                          e.preventDefault();
                          saveSetChanges();
                        }
                      }}
                      className={`bg-transparent ${editingSet.errors?.artist ? 'border-b border-red-500' : ''} font-medium text-sm text-edc-pink focus:outline-none focus:border-b focus:border-edc-pink/50 w-full text-center`}
                    />
                    <div className="text-white text-center">
                      <input 
                        type="time"
                        value={editingSet.time}
                        onChange={(e) => {
                          const newValue = e.target.value;
                          setEditingSet({...editingSet, time: newValue, errors: {...(editingSet.errors || {}), time: !newValue}});
                        }}
                        onKeyDown={(e) => {
                          if (e.key === 'Escape') {
                            setEditingSet(null);
                          } else if (e.key === 'Enter') {
                            e.preventDefault();
                            saveSetChanges();
                          }
                        }}
                        className={`bg-transparent ${editingSet.errors?.time ? 'border-b border-red-500' : ''} text-sm text-white focus:outline-none focus:border-b focus:border-white/30 appearance-none [&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-inner-spin-button]:hidden [&::-webkit-outer-spin-button]:hidden [&::-webkit-clear-button]:hidden [&::-ms-clear]:hidden w-[90px] text-center mx-auto`}
                        style={{
                          appearance: 'none',
                          '-webkit-appearance': 'none',
                          '-moz-appearance': 'textfield'
                        }}
                      />
                    </div>
                    <div className="text-edc-blue flex items-center">
                      <input 
                        type="text" 
                        placeholder="Stage"
                        value={editingSet.stage}
                        onChange={(e) => {
                          const newValue = e.target.value;
                          setEditingSet({...editingSet, stage: newValue, errors: {...(editingSet.errors || {}), stage: !newValue.trim()}});
                        }}
                        onKeyDown={(e) => {
                          if (e.key === 'Escape') {
                            setEditingSet(null);
                          } else if (e.key === 'Enter') {
                            e.preventDefault();
                            saveSetChanges();
                          }
                        }}
                        className={`bg-transparent ${editingSet.errors?.stage ? 'border-b border-red-500' : ''} text-sm text-edc-blue focus:outline-none focus:border-b focus:border-edc-blue/50 w-[70%] text-center`}
                      />
                      <div className="flex shrink-0 ml-auto">
                        <button 
                          type="submit"
                          className="text-edc-purple hover:text-edc-blue mx-1"
                          title="Save Changes"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                          </svg>
                        </button>
                        <button 
                          type="button"
                          onClick={() => setEditingSet(null)}
                          className="text-red-400 hover:text-red-300 ml-1"
                          title="Cancel"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </form>
                ) : (
                  <div className="grid grid-cols-3 gap-2 text-sm py-2">
                    <div className="text-edc-pink font-medium truncate">{set.artist}</div>
                    <div className="text-white">{formattedTime}</div>
                    <div className="text-edc-blue truncate flex justify-between items-center">
                      <span className="truncate flex-1 text-center">{set.stage}</span>
                      <div className="flex">
                        <button
                          onClick={() => setEditingSet({
                            index,
                            artist: set.artist,
                            stage: set.stage,
                            time: formatTimeForInput(new Date(set.start))
                          })}
                          className="text-edc-purple hover:text-edc-blue ml-1 opacity-0 group-hover:opacity-100 hover:opacity-100"
                          title="Edit Set"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                          </svg>
                        </button>
                        <button
                          onClick={() => deleteSet(index)}
                          className="text-red-400 hover:text-red-300 ml-1 opacity-0 group-hover:opacity-100 hover:opacity-100"
                          title="Delete Set"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m6-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        
{/* Add Set button or add form at bottom for better UX */}
{isAddingSet ? (
<div className="mt-3 border-t border-edc-purple/20 pt-2" ref={addFormRef}>
<form onSubmit={(e) => {
e.preventDefault();
addNewSet();
}}
className="grid grid-cols-[1fr_auto_1fr] md:grid-cols-3 gap-2 text-sm py-2 group"
>
<input 
type="text" 
placeholder="Artist"
value={tempNewSet?.artist || ''}
onChange={(e) => {
const newValue = e.target.value;
setTempNewSet({
...tempNewSet,
artist: newValue, 
errors: {...(tempNewSet?.errors || {}), artist: !newValue.trim()}
});
}}
onKeyDown={(e) => {
if (e.key === 'Escape') {
setTempNewSet(null);
} else if (e.key === 'Enter') {
e.preventDefault();
addNewSet();
}
}}
className={`bg-transparent ${tempNewSet?.errors?.artist ? 'border-b border-red-500' : ''} font-medium text-sm text-edc-pink focus:outline-none focus:border-b focus:border-edc-pink/50 w-full text-center`}
/>
<div className="text-white text-center">
<input 
type="time"
value={tempNewSet?.time || ''}
onChange={(e) => {
const newValue = e.target.value;
setTempNewSet({
...tempNewSet,
time: newValue, 
errors: {...(tempNewSet?.errors || {}), time: !newValue}
});
}}
onKeyDown={(e) => {
if (e.key === 'Escape') {
setTempNewSet(null);
} else if (e.key === 'Enter') {
e.preventDefault();
addNewSet();
}
}}
className={`bg-transparent ${tempNewSet?.errors?.time ? 'border-b border-red-500' : ''} text-sm text-white focus:outline-none focus:border-b focus:border-white/30 appearance-none [&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-inner-spin-button]:hidden [&::-webkit-outer-spin-button]:hidden [&::-webkit-clear-button]:hidden [&::-ms-clear]:hidden w-[90px] text-center mx-auto`}
style={{
appearance: 'none',
'-webkit-appearance': 'none',
'-moz-appearance': 'textfield'
}}
/>
</div>
<div className="text-edc-blue flex items-center">
<input 
type="text" 
placeholder="Stage"
value={tempNewSet?.stage || ''}
onChange={(e) => {
const newValue = e.target.value;
setTempNewSet({
...tempNewSet,
stage: newValue, 
errors: {...(tempNewSet?.errors || {}), stage: !newValue.trim()}
});
}}
onKeyDown={(e) => {
if (e.key === 'Escape') {
setTempNewSet(null);
} else if (e.key === 'Enter') {
e.preventDefault();
addNewSet();
}
}}
className={`bg-transparent ${tempNewSet?.errors?.stage ? 'border-b border-red-500' : ''} text-sm text-edc-blue focus:outline-none focus:border-b focus:border-edc-blue/50 w-[70%] text-center`}
/>
<div className="flex shrink-0 ml-auto">
<button 
type="submit"
className="text-edc-purple hover:text-edc-blue mx-1"
title="Save Set"
>
<svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
<path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
</svg>
</button>
<button 
type="button"
onClick={() => {
setIsAddingSet(false);
setTempNewSet(null);
}}
className="text-red-400 hover:text-red-300 ml-1"
title="Cancel"
>
<svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
<path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
</svg>
</button>
</div>
</div>
</form>
</div>
) : (
<div className="flex justify-center mt-3">
<button 
data-add-set-button="manual"
onClick={() => {
setIsAddingSet(true);
setTempNewSet({
artist: '',
stage: '',
time: '',
errors: {}
});
}}
className="bg-edc-blue/20 hover:bg-edc-blue/30 text-edc-blue hover:text-edc-purple text-sm font-medium py-2 px-4 rounded-md flex items-center transition-all duration-200"
title="Add Set"
>
<svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
<path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
</svg>
Add Set
</button>
</div>
)}
</div>
);
};

  // Toggle between AI parser and manual entry modes
              );
            };

  // Toggle between AI parser and manual entry modes
  const toggleEntryMode = useCallback(() => {
    // Clear sets when toggling modes
    setProcessedSets([]);
    setEditingSet(null);
    setTempNewSet(null);
    setIsAddingSet(false);
    setTableInput('');
    
    const newMode = !isManualEntry;
    setIsManualEntry(newMode);
    
    // If switching to manual mode, start with the add set form
    if (newMode) {
      setIsAddingSet(true);
    }
    
    // Notify parent component
    if (onToggleMode) {
      onToggleMode(newMode);
    }
  }, [isManualEntry, onToggleMode]);
  
  // Expose toggle function to parent via ref
  useEffect(() => {
    if (toggleButtonRef) {
      toggleButtonRef.current = {
        toggle: toggleEntryMode,
        isManualMode: isManualEntry
      };
    }
  }, [toggleButtonRef, isManualEntry, toggleEntryMode]);

  // Use useEffect to notify parent of initial state on mount
  useEffect(() => {
    if (onToggleMode) {
      onToggleMode(isManualEntry);
    }
    
    // If in manual entry mode, automatically start adding a set
    if (isManualEntry && processedSets.length === 0) {
      setIsAddingSet(true);
      // Initialize the temp new set for the edit form
      setTempNewSet({
        artist: '',
        stage: '',
        time: '',
        errors: {}
      });
    }
  }, [onToggleMode, isManualEntry, processedSets.length]);

  return (
    <div className="space-y-4">
      
      {!isManualEntry && (
        <>
          <div className="space-y-3">
            <div className="space-y-3">
              <div className="bg-black/40 border border-edc-purple/40 rounded-lg p-4">
                <h3 className="text-edc-blue text-sm font-medium mb-4">AI Set Parser</h3>
                
                <div className="flex flex-col space-y-3">
                  {/* Step 1: Get data */}
                  <div className="flex items-center space-x-2">
                    <div className="bg-edc-blue/60 text-white text-xs font-medium rounded-full w-5 h-5 flex items-center justify-center">1</div>
                    <span className="text-white/80 text-xs">Get schedule</span>
                    <a 
                      href="https://chatgpt.com/g/g-68655cca11a8819199c988aa0d95c3c4-music-festival-schedule-parser" 
                      target="_blank" 
                      rel="noopener noreferrer"
                      className="bg-edc-purple/80 text-white px-3 py-1 rounded-md hover:bg-edc-purple transition-colors text-xs font-medium"
                    >
                      GPT Schedule Parser
                    </a>
                    <details className="group inline-block">
                      <summary className="cursor-pointer text-edc-pink hover:text-edc-purple text-xs">No ChatGPT account?</summary>
                      <div className="absolute mt-1 p-2 bg-black/60 border border-edc-purple/30 rounded text-xs text-white/80 whitespace-pre-wrap max-h-36 overflow-y-auto max-w-md z-10">
Extract all festival schedule entries with artist name, start time, and stage name from the uploaded image(s). Return only a markdown table in this format:

| Artist | Start Time | Stage Name |

Do not include duplicates across screenshots.
If the image isn't readable or doesn't show a valid schedule, respond only with:
"I couldn't find a readable festival schedule in this image. Please upload a clearer screenshot."
                      </div>
                    </details>
                  </div>
                  
                  {/* Step 2: Paste table */}
                  <div className="flex items-start">
                    <div className="bg-edc-blue/60 text-white text-xs font-medium rounded-full w-5 h-5 flex items-center justify-center mt-1 mr-2">2</div>
                    <div className="flex-1">
                      <div className="flex justify-between mb-1">
                        <span className="text-white/80 text-xs">Paste table here</span>
                        <button
                          onClick={() => setTableInput('')}
                          className="text-red-400 hover:text-red-300 text-xs"
                        >
                          Clear
                        </button>
                      </div>
                      <textarea
                        value={tableInput}
                        onChange={(e) => setTableInput(e.target.value)}
                        placeholder={`Example format:
| Artist        | Start Time | Stage Name    |
| ------------- | ---------- | ------------- |
| Subtronics    | 10:00 PM   | Main Stage    |
| Martin Garrix | 11:20 PM   | Kinetic Grass |
`}
                        className="w-full h-32 bg-transparent border border-edc-purple/30 rounded text-white text-sm p-3 resize-none focus:outline-none focus:border-edc-pink/50 placeholder-white/40"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          {/* Error message display */}
          {errorMessage && (
            <div className="mt-2 bg-red-900/60 border border-red-500/50 p-3 rounded-md relative">
              <div className="flex items-start">
                <div className="text-red-400 text-sm pr-6">{errorMessage}</div>
                <button 
                  onClick={() => setErrorMessage('')}
                  className="absolute top-2 right-2 text-red-400 hover:text-red-300"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
          )}
          
          {/* Moved Add Schedule button outside the nested divs */}
          <div className="flex justify-center mt-4">
            <button
              onClick={processTableInput}
              disabled={!tableInput.trim() || isProcessing}
              className="bg-gradient-to-r from-edc-pink to-edc-purple hover:opacity-90 hover:shadow-md hover:shadow-edc-pink/20 disabled:opacity-50 disabled:bg-gray-700 text-white text-sm font-medium py-3 px-8 rounded-md transition-all duration-200 w-1/3"
            >
              {isProcessing ? 'Processing...' : 'Add Schedule'}
            </button>
          </div>
        </>
      )}
      
      {renderProcessedSets()}
    </div>
  );
};
};

export default FestivalScheduleUploader;
